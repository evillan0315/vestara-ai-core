{
  "schemaVersion": 1,
  "id": "monorepo-build-matrix",
  "name": "Marketplace Monorepo Build Matrix",
  "description": "Builds every app and package in apps/ and packages/ (including providers and tools) in dependency order, then verifies with lint and type-aware build references.",
  "goal": "Build all 5 apps and 118 packages/tools in dependency order with verification",
  "stages": [
    {
      "id": "install",
      "name": "Install dependencies",
      "runs": "pnpm install --frozen-lockfile"
    },
    {
      "id": "references",
      "name": "Regenerate build references",
      "runs": "pnpm build:references"
    },
    {
      "id": "build",
      "name": "Build all workspaces in topological order",
      "runs": "bash workflows/monorepo-build-matrix.sh --build"
    },
    {
      "id": "verify",
      "name": "Verify boundaries and source artifacts",
      "runs": "pnpm dependencies:check && pnpm check:source-artifacts"
    },
    {
      "id": "lint",
      "name": "Lint check",
      "runs": "pnpm lint:check"
    }
  ],
  "targets": [
