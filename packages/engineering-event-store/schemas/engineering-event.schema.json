{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vestara.dev/schemas/engineering-event.schema.json",
  "title": "Vestara Durable Engineering Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "seq",
    "at",
    "type",
    "source",
    "actorId",
    "authority",
    "workspaceId",
    "correlationId",
    "payload",
    "previousHash",
    "hash"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "seq": { "type": "integer", "minimum": 1 },
    "at": { "type": "string", "format": "date-time" },
    "type": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "actorId": { "type": "string", "minLength": 1 },
    "authority": { "enum": ["user", "system", "agent", "policy", "verification"] },
    "workspaceId": { "type": "string", "minLength": 1 },
    "environmentId": { "type": "string" },
    "taskId": { "type": "string" },
    "threadId": { "type": "string" },
    "turnId": { "type": "string" },
    "toolCallId": { "type": "string" },
    "verificationRunId": { "type": "string" },
    "correlationId": { "type": "string", "minLength": 1 },
    "causationId": { "type": "string" },
    "payload": { "type": "object" },
    "previousHash": { "type": "string", "minLength": 1 },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
