{
  "$schema": "https://typedoc.org/schema.json",
  "name": "Vestara AI Core API",
  "entryPoints": [
    "packages/shared/src/index.ts",
    "packages/configuration/src/index.ts",
    "packages/logger/src/index.ts",
    "packages/metrics/src/index.ts",
    "packages/event-bus/src/index.ts",
    "packages/service-registry/src/index.ts",
    "packages/health/src/index.ts",
    "packages/permission/src/index.ts",
    "packages/stream/src/index.ts",
    "packages/provider-runtime/src/index.ts",
    "packages/providers/opencode/src/index.ts",
    "packages/context/src/index.ts",
    "packages/memory/src/index.ts",
    "packages/cognitive/src/index.ts",
    "packages/knowledge/src/index.ts",
    "packages/reasoning/src/index.ts",
    "packages/action/src/index.ts",
    "packages/state-runtime/src/index.ts",
    "packages/conversation/src/index.ts",
    "packages/workspace/src/index.ts",
    "packages/events/src/index.ts",
    "packages/events-server/src/index.ts",
    "packages/os-controller/src/index.ts",
    "packages/kernel/src/index.ts",
    "packages/tools/filesystem/src/index.ts"
