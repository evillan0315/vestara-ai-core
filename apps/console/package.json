{
  "name": "@vestara/console",
  "description": "Compatibility launcher for the canonical @vestara/tui package",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
