{
  "name": "@vestara/console",
  "description": "Ink-based interactive engineering console for Vestara",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run --root ../.. apps/console/__tests__"
  },
  "dependencies": {
    "@vestara/configuration": "workspace:*",
    "@vestara/workspace": "workspace:*",
    "ink": "7.0.6",
    "react": "19.2.4"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "ink-testing-library": "4.0.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}
