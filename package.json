{
  "name": "vestara-ai-core",
  "version": "0.3.0",
  "private": true,
  "description": "Vestara AI Core Runtime — Engineering Phase",
  "scripts": {
    "build": "pnpm build:references",
    "build:references": "node scripts/workspace-architecture.mjs --generate && tsc -b tsconfig.references.json",
    "dependencies:check": "node scripts/workspace-architecture.mjs --check",
    "references:generate": "node scripts/workspace-architecture.mjs --generate",
    "watch": "tsc -b -w",
    "clean": "tsc -b --clean",
    "test": "vitest run",
    "vestara": "node apps/cli/dist/index.js",
    "console": "node apps/cli/dist/index.js console",
    "doctor": "node apps/cli/dist/index.js doctor",
    "milestone-status": "bash scripts/milestone-status.sh",
    "ensure-docs": "bash scripts/ensure-docs.sh",
    "vds:validate": "node scripts/vds-validate.mjs",
    "docs:validate": "node scripts/docs-automation.mjs validate",
    "docs:status": "node scripts/docs-automation.mjs status",
    "docs:review-due": "node scripts/docs-automation.mjs review-due",
    "docs:links": "node scripts/docs-automation.mjs links",
    "docs:drift": "node scripts/docs-automation.mjs drift",
    "docs:evidence": "node scripts/docs-automation.mjs evidence",
    "docs:impact": "node scripts/docs-automation.mjs impact",
    "docs:govern": "node scripts/docs-automation.mjs validate --strict && node scripts/docs-automation.mjs links --strict && node scripts/docs-automation.mjs evidence --strict",
    "generate-docs": "bash scripts/generate-docs.sh",
    "docs": "bash scripts/generate-docs.sh",
    "benchmark": "bash scripts/benchmark.sh",
    "conversation-audit": "node packages/conversation-runtime/dist/audit/cli.js",
    "documentation:baseline": "node apps/cli/dist/index.js docs baseline --output docs/documentation-baseline.json --json",
    "documentation:check": "node apps/cli/dist/index.js docs check --baseline docs/documentation-baseline.json --output docs/documentation-ci-report.json --json",
    "benchmark-index": "bash scripts/benchmark-index.sh",
    "lint": "biome check --write",
    "lint:check": "biome check --diagnostic-level=error",
    "format": "biome format --write",
    "dev:api": "node apps/api/dist/index.js",
    "dev:ui": "pnpm --filter @vestara/workspace-ui dev",
    "dev": "node apps/api/dist/index.js & pnpm --filter @vestara/workspace-ui dev; kill %1",
    "screenshots": "pnpm --filter @vestara/workspace-ui screenshots",
    "screenshots:update": "pnpm --filter @vestara/workspace-ui screenshots:update",
    "screenshots:mobile": "pnpm --filter @vestara/workspace-ui screenshots:mobile",
    "screenshots:tablet": "pnpm --filter @vestara/workspace-ui screenshots:tablet",
    "screenshots:desktop": "pnpm --filter @vestara/workspace-ui screenshots:desktop",
    "screenshots:ci": "pnpm --filter @vestara/workspace-ui screenshots:ci",
    "screenshots:report": "pnpm --filter @vestara/workspace-ui screenshots:report",
    "screenshots:clean": "pnpm --filter @vestara/workspace-ui screenshots:clean",
    "screenshots:check": "pnpm --filter @vestara/workspace-ui screenshots:check"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/node": "^26.1.1",
    "typedoc": "^0.28.20",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "sql.js": "^1.14.1"
  }
}
