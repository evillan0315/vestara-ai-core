background_image = Image("background.png");

# Scale background to fill the screen while preserving aspect ratio.
screen_ratio = Window.GetWidth() / Window.GetHeight();
image_ratio = background_image.GetWidth() / background_image.GetHeight();

if (screen_ratio > image_ratio)
  scale = Window.GetWidth() / background_image.GetWidth();
else
  scale = Window.GetHeight() / background_image.GetHeight();

background_image = background_image.Scale(
  background_image.GetWidth() * scale,
  background_image.GetHeight() * scale
);

background_sprite = Sprite(background_image);
background_sprite.SetPosition(
  Window.GetX() + (Window.GetWidth() - background_image.GetWidth()) / 2,
  Window.GetY() + (Window.GetHeight() - background_image.GetHeight()) / 2,
  -100
);

# Load and scale the loading throbber frames.
frame_count = 20;
for (i = 0; i < frame_count; i++)
  {
    if (i < 10)
      frame_name = "throbber-0" + i + ".png";
    else
      frame_name = "throbber-" + i + ".png";

    frame = Image(frame_name);

    target_size = Window.GetHeight() * 0.22;
    frame_scale = target_size / frame.GetHeight();

    frames[i] = frame.Scale(
      frame.GetWidth() * frame_scale,
      frame.GetHeight() * frame_scale
    );
  }

frame_index = 0;
refresh_count = 0;

throbber_sprite = Sprite(frames[frame_index]);
throbber_sprite.SetPosition(
  Window.GetX() + Window.GetWidth() / 2 - frames[0].GetWidth() / 2,
  Window.GetY() + Window.GetHeight() / 2 - frames[0].GetHeight() / 2,
  0
);

fun refresh_callback ()
  {
    refresh_count++;

    # Plymouth refreshes frequently; advance at roughly 15 FPS.
    if (refresh_count % 4 == 0)
      {
        frame_index = (frame_index + 1) % frame_count;
        throbber_sprite.SetImage(frames[frame_index]);
      }
  }

Plymouth.SetRefreshFunction(refresh_callback);
